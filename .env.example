# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# Convex deployment's HTTP Actions URL (usually https://<deployment>.convex.site).
# Convex sets this for deployed functions; do not use the Vite localhost URL here.
CONVEX_SITE_URL=

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=
